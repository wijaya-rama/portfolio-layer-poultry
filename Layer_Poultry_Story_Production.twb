        <zone forceUpdate="true" h="3333" id="14012" type-v2="text" w="11806" x="85000" y="3889">
          <formatted-text>
            <run fontcolor="#ffffff" fontname="Segoe UI" fontsize="9" bold="true">Financials &amp; BEP</run></formatted-text>
        </zone>
        <zone forceUpdate="true" h="4200" id="14025" type-v2="text" w="95833" x="2083" y="15889">
          <formatted-text>
            <run fontcolor="#94a3b8" fontname="Segoe UI" fontsize="10">A Rp 2,920/kg lower BEP shields Closed House against volatile farmgate egg prices and feed cost surges, securing whole-cycle EBITDA.</run></formatted-text>
        </zone>
        <zone h="76222" id="14201" is-scaled="1" param="G:/My Drive/Bismillah/01_Backup_PC_Kerjaan/Download/Tableau/04_Layer_Poultry_Story/assets/dark/cards/card_manager_leaderboard.png" type-v2="bitmap" w="36111" x="2083" y="20444" />
        <zone h="2667" id="14202" is-centered="0" is-scaled="1" param="G:/My Drive/Bismillah/01_Backup_PC_Kerjaan/Download/Tableau/04_Layer_Poultry_Story/assets/dark/badges/badge_bep_sensitivity_265x24.png" type-v2="bitmap" w="22569" x="2847" y="22667" />
        <zone forceUpdate="true" h="2222" id="14203" type-v2="text" w="21181" x="3194" y="23000">
          <formatted-text>
            <run fontcolor="#60A5FA" fontname="Segoe UI" fontsize="8" bold="true">BREAK-EVEN SENSITIVITY</run></formatted-text>
        </zone>
        <zone forceUpdate="true" h="3111" id="14204" type-v2="text" w="32986" x="3611" y="26222">
          <formatted-text>
            <run fontcolor="#f8fafc" fontname="Segoe UI" fontsize="12" bold="true">Operating Margin Sensitivity to Farmgate Market Price</run></formatted-text>
        </zone>
        <zone forceUpdate="true" h="5556" id="14205" type-v2="text" w="32986" x="3611" y="29333">
          <formatted-text>
            <run fontcolor="#94a3b8" fontname="Segoe UI" fontsize="8">Closed House retains positive margin down to Rp 22,550/kg; Open House suffered -Rp 1.14B cumulative losses due to feed inefficiency.</run></formatted-text>
        </zone>
        <zone h="60667" id="14206" name="T4_BEP_Margin_Sensitivity_Dark" show-title="false" w="33611" x="3333" y="33778" />
