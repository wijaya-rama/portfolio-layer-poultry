      <column caption="c_Peak_HDP" datatype="real" name="[Calculation_Peak_HDP]" role="measure" type="quantitative" default-format="0.0%"><calculation class="tableau" formula="AVG([peak_hdp_pct])" /></column><column caption="c_Weeks_Above_90" datatype="real" name="[Calculation_Weeks_Above_90]" role="measure" type="quantitative" default-format="0.0"><calculation class="tableau" formula="AVG([weeks_above_90pct_hdp])" /></column><column caption="c_Lifetime_FCR" datatype="real" name="[Calculation_Lifetime_FCR]" role="measure" type="quantitative" default-format="0.000"><calculation class="tableau" formula="AVG([lifetime_fcr_kg_egg])" /></column><column caption="c_Reject_Rate_Pct" datatype="real" name="[Calculation_Reject_Rate_Pct]" role="measure" type="quantitative" default-format="0.00%"><calculation class="tableau" formula="SUM([reject_eggs_count]) / SUM([total_eggs_collected])" /></column><column caption="c_Mortality_Rate_Pct" datatype="real" name="[Calculation_Mortality_Rate]" role="measure" type="quantitative" default-format="0.00%"><calculation class="tableau" formula="SUM([daily_mortality_hens]) / MAX([initial_pullets_housed])" /></column><column caption="c_HHP_Eggs_Per_Bird" datatype="real" name="[Calculation_HHP_Eggs]" role="measure" type="quantitative" default-format="#,##0.0"><calculation class="tableau" formula="SUM([total_eggs_collected]) / MAX([initial_pullets_housed])" /></column><column caption="c_Net_Profit_Billion" datatype="real" name="[Calculation_Net_Profit_Billion]" role="measure" type="quantitative" default-format="Rp #,##0.00 M"><calculation class="tableau" formula="SUM([daily_net_margin_idr]) / 1000000000" /></column><column caption="c_Net_Margin_Per_Kg" datatype="real" name="[Calculation_Net_Margin_Kg]" role="measure" type="quantitative" default-format="Rp #,##0"><calculation class="tableau" formula="SUM([daily_net_margin_idr]) / SUM([daily_egg_mass_kg])" /></column><column caption="c_Total_Egg_Mass_Tons" datatype="real" name="[Calculation_Egg_Mass_Tons]" role="measure" type="quantitative" default-format="#,##0.0 Ton"><calculation class="tableau" formula="SUM([daily_egg_mass_kg]) / 1000" /></column><column caption="c_Feed_Cost_Per_Kg_Egg" datatype="real" name="[Calculation_Feed_Cost_Kg]" role="measure" type="quantitative" default-format="Rp #,##0"><calculation class="tableau" formula="SUM([daily_feed_cost_idr]) / SUM([daily_egg_mass_kg])" /></column><column caption="c_Color_Housing" datatype="string" name="[Calculation_Color_Housing]" role="dimension" type="nominal"><calculation class="tableau" formula="IF [house_type] = 'Closed House' THEN 'Closed House (Focus)' ELSE 'Open House (Standard)' END" /></column><column caption="c_Color_THI" datatype="string" name="[Calculation_Color_THI]" role="dimension" type="nominal"><calculation class="tableau" formula="IF [thi_index] &gt;= 78.0 THEN 'Heat Stress (THI &gt;= 78)' ELSE 'Comfort Zone (THI &lt; 78)' END" /></column><column caption="c_Color_Cluster" datatype="string" name="[Calculation_Color_Cluster]" role="dimension" type="nominal"><calculation class="tableau" formula="[location_farm]" /></column><column caption="Record Id" datatype="integer" name="[record_id]" role="measure" type="quantitative" /><column caption="Record Date" datatype="date" name="[record_date]" role="dimension" type="nominal" /><column caption="Flock Age Weeks" datatype="integer" name="[flock_age_weeks]" role="measure" type="quantitative" /><column caption="Flock Age Days" datatype="integer" name="[flock_age_days]" role="measure" type="quantitative" /><column caption="Flock Id" datatype="string" name="[flock_id]" role="dimension" type="nominal" /><column caption="Flock Name" datatype="string" name="[flock_name]" role="dimension" type="nominal" /><column caption="House Id" datatype="string" name="[house_id]" role="dimension" type="nominal" /><column caption="House Name" datatype="string" name="[house_name]" role="dimension" type="nominal" /><column caption="House Type" datatype="string" name=